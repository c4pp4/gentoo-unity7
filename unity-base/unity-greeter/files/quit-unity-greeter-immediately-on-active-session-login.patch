From 4a57d099573c7fdf5b077359dc2a8f7836692330 Mon Sep 17 00:00:00 2001
From: c4pp4
Date: Wed, 21 Oct 2026 11:42:39 +0200
Subject: [PATCH 1/1] Quit unity-greeter immediately when the session starts on
 another VT

When logging in to an already active session, LightDM switches to the
VT of that session (and waits until the switch completes), sends
SIGTERM to the greeter and only then replies to the start session
request. Xorg suspends all GLX clients when its VT is released, and
GTK makes the greeter a GLX client by probing GLX visuals on startup.
Any X round trip after that blocks until the VT is active again, which
never happens, so the SIGTERM handler in the main loop is never run
and the greeter (and its X server) keeps running, as LightDM does not
escalate to SIGKILL.

Exit right after the session was started if our VT (XDG_VTNR) is no
longer the active one.

Signed-off-by: c4pp4
---
 src/greeter-list.vala | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/src/greeter-list.vala b/src/greeter-list.vala
index cc397d6..2aca3e5 100644
--- a/src/greeter-list.vala
+++ b/src/greeter-list.vala
@@ -926,6 +926,36 @@ public abstract class GreeterList : FadableBox
         /* Set the background */
         background.draw_grid = false;
         background.queue_draw ();
+
+        /* LightDM switched to another VT (e.g. it returned to an existing
+         * session) before replying. Xorg suspends GLX clients on VT switch,
+         * so any X round trip would block forever and the SIGTERM sent by
+         * LightDM would never be handled. There is nothing left to show,
+         * so exit right away. */
+        if (!is_vt_active ())
+        {
+            debug ("Session started successfully on another VT - exiting greeter.");
+            Posix.exit (Posix.EXIT_SUCCESS);
+        }
+    }
+
+    private static bool is_vt_active ()
+    {
+        var vtnr = Environment.get_variable ("XDG_VTNR");
+        if (vtnr == null)
+            return true;
+
+        string active;
+        try
+        {
+            FileUtils.get_contents ("/sys/class/tty/tty0/active", out active);
+        }
+        catch (FileError e)
+        {
+            return true;
+        }
+
+        return active.strip () == "tty" + vtnr;
     }
 
     public void login_complete ()
