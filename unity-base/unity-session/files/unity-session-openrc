#!/bin/sh

# Start the Unity session without the 'systemd --user' process #
#  cinnamon-session launches compiz, unity-panel-service and other components #
#  from XDG autostart files, and D-Bus activation starts the indicator services #

# some old Qt programs still check this long-deprecated env var
export GNOME_DESKTOP_SESSION_ID=this-is-deprecated

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
	exec dbus-run-session -- cinnamon-session --session=unity "$@"
fi

dbus-update-activation-environment GNOME_DESKTOP_SESSION_ID
exec cinnamon-session --session=unity "$@"
