#!/bin/sh
## Show Unity's dialogs, as gnome-session-quit does. In Unity, cinnamon-session
##  logs out without a prompt (logout-prompt = false) and reboots and shuts
##  down without a dialog.

BUS="com.canonical.Unity"
OBJ="/com/canonical/Unity/Session"
IFACE="com.canonical.Unity.Session"

ACTION="${1:---logout}"

case "$ACTION" in
  --logout)
    METHOD="RequestLogout"
    ;;
  --reboot)
    METHOD="RequestReboot"
    ;;
  --power-off)
    METHOD="RequestShutdown"
    ;;
  *)
    echo "Options: $0 {--logout|--reboot|--power-off}" >&2
    exit 1
    ;;
esac

gdbus call --session --dest $BUS --object-path $OBJ --method $IFACE.$METHOD
