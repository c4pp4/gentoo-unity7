+cu::PixmapTexture::Ptr Window::Impl::BuildMenuShadowTexture(nux::Size const& size, unsigned radius, nux::Color const& color)
+{
+  enum Corner { TOP_LEFT, TOP_RIGHT, BOTTOM_LEFT, BOTTOM_RIGHT };
+  nux::CairoGraphics img(CAIRO_FORMAT_ARGB32, size.width, size.height);
+  auto* img_ctx = img.GetInternalContext();
+  double margin = radius * SHADOW_BLUR_MARGIN_FACTOR;
+  double width = size.width - margin * 2;
+  double height = size.height - margin * 2;
+  std::array<double, 4> r;
+
+  for (unsigned i = 0; i < r.size(); ++i)
+    r[i] = std::min<double>(client_corners_[i], std::min(width, height) / 2);
+
+  // The shape of the menu, with the corners that GTK published
+  cairo_new_sub_path(img_ctx);
+  cairo_arc(img_ctx, margin + width - r[TOP_RIGHT], margin + r[TOP_RIGHT], r[TOP_RIGHT], -M_PI / 2, 0);
+  cairo_arc(img_ctx, margin + width - r[BOTTOM_RIGHT], margin + height - r[BOTTOM_RIGHT], r[BOTTOM_RIGHT], 0, M_PI / 2);
+  cairo_arc(img_ctx, margin + r[BOTTOM_LEFT], margin + height - r[BOTTOM_LEFT], r[BOTTOM_LEFT], M_PI / 2, M_PI);
+  cairo_arc(img_ctx, margin + r[TOP_LEFT], margin + r[TOP_LEFT], r[TOP_LEFT], M_PI, M_PI * 3 / 2);
+  cairo_close_path(img_ctx);
+  cairo_set_source_rgba(img_ctx, color.red, color.green, color.blue, color.alpha);
+  cairo_fill(img_ctx);
+
+  img.BlurSurface(radius);
+
+  cu::CairoContext shadow_ctx(size.width, size.height);
+  cairo_set_source_surface(shadow_ctx, img.GetSurface(), 0, 0);
+  cairo_paint(shadow_ctx);
+
+  return shadow_ctx;
+}
+
+void Window::Impl::ComputeMenuShadowQuad()
+{
+  // A menu is never the active window, but it is in use while it is open
+  nux::Color const& color = manager_->active_shadow_color();
+  unsigned radius = manager_->active_shadow_radius();
+  auto const& border = win_->borderRect();
+  auto const& shadow_offset = manager_->shadow_offset();
+  int margin = radius * SHADOW_BLUR_MARGIN_FACTOR;
+  nux::Size size(border.width() + margin * 2, border.height() + margin * 2);
+  bool rebuilt = false;
+
+  if (!shaped_shadow_pixmap_ || size != menu_shadow_size_ || radius != menu_shadow_radius_ ||
+      color != menu_shadow_color_ || client_corners_ != menu_shadow_corners_)
+  {
+    shaped_shadow_pixmap_ = BuildMenuShadowTexture(size, radius, color);
+    menu_shadow_size_ = size;
+    menu_shadow_radius_ = radius;
+    menu_shadow_color_ = color;
+    menu_shadow_corners_ = client_corners_;
+    rebuilt = true;
+  }
+
+  const auto* texture = shaped_shadow_pixmap_->texture();
+
+  if (!texture || !texture->width() || !texture->height())
+    return;
+
+  auto* quad = &shadow_quads_[Quads::Pos(0)];
+  quad->box.setGeometry(border.x() + shadow_offset.x - margin, border.y() + shadow_offset.y - margin, size.width, size.height);
+  quad->matrix = texture->matrix();
+  quad->matrix.x0 = -COMP_TEX_COORD_X(quad->matrix, quad->box.x1());
+  quad->matrix.y0 = -COMP_TEX_COORD_Y(quad->matrix, quad->box.y1());
+
+  if (rebuilt || quad->box != last_shadow_rect_)
+  {
+    // Paint the shadow also under the transparent corners of the menu
+    int corner = *std::max_element(client_corners_.begin(), client_corners_.end());
+    corner = std::min({corner, border.width() / 2, border.height() / 2});
+    CompRegion covered(border.x() + corner, border.y(), border.width() - corner * 2, border.height());
+    covered += CompRect(border.x(), border.y() + corner, border.width(), border.height() - corner * 2);
+    quad->region = CompRegion(quad->box) - covered;
+
+    last_shadow_rect_ = quad->box;
+    win_->updateWindowOutputExtents();
+  }
+}
