-          GLib.ChildWatch.add (pid, thumbnailer_process_watch);
-          thumbnailer_pids.add (pid);
-        }
-        catch (Error e)
-        {
-          warning ("Failed to spawn thumbailer: %s", e.message);
-        }
-      }
