From d692b3f5ad8094c279786013ef92623b6012251b Mon Sep 17 00:00:00 2001
From: c4pp4
Date: Sun, 25 Oct 2026 03:52:31 +0100
Subject: [PATCH 1/1] Fix invalid escape sequences

The '\(' and '\)' string literals are invalid escape sequences, which
Python reports with a SyntaxWarning. Use raw strings.

Signed-off-by: c4pp4
---
 src/unity_calculator_daemon.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/unity_calculator_daemon.py b/src/unity_calculator_daemon.py
index 5835801..ef6ead8 100644
--- a/src/unity_calculator_daemon.py
+++ b/src/unity_calculator_daemon.py
@@ -71,8 +71,8 @@ def search(search, filters):
     search = search.replace(';','')
     search = search.replace('&','')
     hint = search
-    hint = hint.replace('\(','(')
-    hint = hint.replace('\)',')')
+    hint = hint.replace(r'\(','(')
+    hint = hint.replace(r'\)',')')
     hint = hint.replace('sqrt','√')
     print ("Operation: %s" % hint)
     try:
-- 
