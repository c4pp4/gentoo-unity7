From 11461400afe9509c909fd84c51989aea9b390339 Mon Sep 17 00:00:00 2001
From: c4pp4
Date: Fri, 06 Nov 2026 14:00:36 +0100
Subject: [PATCH 1/1] Fix bookmarks with current Firefox

Firefox 55 moved the favicons from places.sqlite to favicons.sqlite, so
the bookmarks query fails on the missing moz_favicons table. Query the
bookmarks without favicons (the thumbnails are used as icons anyway).

Look up firefox or firefox-bin in PATH instead of the fixed
/usr/bin/firefox path.

Return no results without ~/.mozilla/firefox/; the search failed on
os.listdir() until Firefox was run for the first time.

Require the Unity version before the import; otherwise PyGI warns.

Signed-off-by: c4pp4
---
 src/unity_firefoxbookmarks_daemon.py | 19 +++++++++++--------
 1 file changed, 11 insertions(+), 8 deletions(-)

diff --git a/src/unity_firefoxbookmarks_daemon.py b/src/unity_firefoxbookmarks_daemon.py
index 44c6ae8..1d43cee 100644
--- a/src/unity_firefoxbookmarks_daemon.py
+++ b/src/unity_firefoxbookmarks_daemon.py
@@ -14,6 +14,8 @@
 # You should have received a copy of the GNU General Public License along
 # with this program.  If not, see <http://www.gnu.org/licenses/>.
 
+import gi
+gi.require_version('Unity', '7.0')
 from gi.repository import GLib, Gio
 from gi.repository import Unity
 import gettext
@@ -39,14 +41,12 @@ PROVIDER_ICON = SVG_DIR + 'group-browserbookmarks.svg'
 DEFAULT_RESULT_ICON = SVG_DIR + 'group-browserbookmarks.svg'
 DEFAULT_RESULT_MIMETYPE = 'text/html'
 DEFAULT_RESULT_TYPE = Unity.ResultType.DEFAULT
-FIREFOX_EXECUTABLE = '/usr/bin/firefox'
+FIREFOX_EXECUTABLE = GLib.find_program_in_path('firefox') or GLib.find_program_in_path('firefox-bin') or '/usr/bin/firefox'
 BOOKMARKS_PATH = os.getenv("HOME") + "/.mozilla/firefox/"
-BOOKMARKS_QUERY = '''SELECT moz_bookmarks.title, moz_places.url, moz_favicons.url, '%s', '%s'
-                     FROM moz_bookmarks, moz_places, moz_favicons
+BOOKMARKS_QUERY = '''SELECT moz_bookmarks.title, moz_places.url, '%s', '%s'
+                     FROM moz_bookmarks, moz_places
                      WHERE moz_places.id = moz_bookmarks.fk
-                         AND moz_places.favicon_id = moz_favicons.id
                          AND moz_bookmarks.title is not null
-                         AND moz_places.favicon_id is not null
                          AND moz_bookmarks.type = 1
                          AND (moz_bookmarks.title LIKE '%%%s%%' OR moz_places.url LIKE '%%%s%%')
                      ORDER BY moz_bookmarks.lastModified;'''
@@ -98,13 +98,16 @@ def search(search, filters):
     Search for help documents matching the search string
     '''
     results = []
-    bookmarks = get_bookmarks_from_firefox(BOOKMARKS_PATH, search)
+    path = BOOKMARKS_PATH
+    if not os.path.isdir(path):
+        return results
+    bookmarks = get_bookmarks_from_firefox(path, search)
 
     for bookmark in bookmarks:
         # Stop Firefox's smart bookmark folders from showing up
         if not bookmark[1].find("place:") == -1:
             continue
-        path = bookmark[4].replace('places.sqlite', 'thumbnails/')
+        path = bookmark[3].replace('places.sqlite', 'thumbnails/')
         path = path.replace('.mozilla/', '.cache/mozilla/') 
         icon = '%s%s.png' % (path, hashlib.md5(bookmark[1].encode()).hexdigest())
         if not os.path.exists(icon):
@@ -113,7 +116,7 @@ def search(search, filters):
                         'icon': icon,
                         'category': 0,
                         'title': bookmark[0],
-                        'user': GLib.Variant('s', bookmark[3])})
+                        'user': GLib.Variant('s', bookmark[2])})
     return results
 
 
