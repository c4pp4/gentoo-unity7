ehooks() {
	## Warn when the default autostart-blacklist changes. The Unity session ##
	## sets it without nm-applet in unity-base/unity-settings ##
	local \
		schema="${S}"/data/org.cinnamon.SessionManager.gschema.xml \
		override="${REPO_ROOT}"/unity-base/unity-settings/files/ubuntu-unity.gsettings-override \
		default unity

	default=$(sed -n "/<key name=\"autostart-blacklist\"/,/<\/key>/s/^ *<default>\(.*\)<\/default>$/\1/p" "${schema}" 2>/dev/null)
	unity=$(sed -n "/^\[org.cinnamon.SessionManager:Unity\]$/,/^\[/s/^autostart-blacklist = //p" "${override}" 2>/dev/null)

	if [[ -z ${default} || -z ${unity} ]]; then
		ewarn "Cannot find the autostart-blacklist of ${CATEGORY}/${PN} or the Unity session:"
		ewarn "  ${schema}"
		ewarn "  ${override}"
	elif [[ $(tr -d "[]' " <<< "${default}" | tr "," "\n" | grep -vx "nm-applet") \
		!= $(tr -d "[]' " <<< "${unity}" | tr "," "\n") ]]; then
		ewarn "The default autostart-blacklist of ${CATEGORY}/${PN} has changed:"
		ewarn "  ${default}"
		ewarn "The Unity session's autostart-blacklist should be the default without nm-applet:"
		ewarn "  ${unity}"
		ewarn "  ${override}"
	fi
}
