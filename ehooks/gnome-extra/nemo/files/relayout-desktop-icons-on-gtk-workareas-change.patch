From fea874d8aadc7ac3a58c2a1437c0d3e39bf81965 Mon Sep 17 00:00:00 2001
From: c4pp4
Date: Sun, 25 Oct 2026 03:41:52 +0100
Subject: [PATCH 1/1] Relayout desktop icons when _GTK_WORKAREAS_D* changes

GTK prefers the per-monitor _GTK_WORKAREAS_D* root window property over
_NET_WORKAREA when the window manager supports it. Compiz updates
_NET_WORKAREA first and _GTK_WORKAREAS_D* right after it, so the margins
read on the _NET_WORKAREA PropertyNotify event can be stale. If the
Unity Launcher strut is set while nemo-desktop is starting, the desktop
icons are then laid out under the Launcher until the next workarea
change.

Update the margins on _GTK_WORKAREAS_D* changes too.

The margins are also read before the root window property events are
selected, so a workarea change in between is missed. Read them after
selecting the events.

Signed-off-by: c4pp4
---
 src/nemo-desktop-icon-grid-view.c | 11 ++++++++---
 src/nemo-desktop-icon-view.c      | 11 ++++++++---
 2 files changed, 16 insertions(+), 6 deletions(-)

diff --git a/src/nemo-desktop-icon-grid-view.c b/src/nemo-desktop-icon-grid-view.c
index 4ef0060..41d3a5f 100644
--- a/src/nemo-desktop-icon-grid-view.c
+++ b/src/nemo-desktop-icon-grid-view.c
@@ -163,7 +163,10 @@ gdk_filter_func (GdkXEvent *gdk_xevent,
 
     switch (xevent->type) {
         case PropertyNotify:
-            if (xevent->xproperty.atom == gdk_x11_get_xatom_by_name ("_NET_WORKAREA")) {
+            /* GTK prefers _GTK_WORKAREAS_D* over _NET_WORKAREA, which the WM
+             * may update after _NET_WORKAREA, so watch for both */
+            if (xevent->xproperty.atom == gdk_x11_get_xatom_by_name ("_NET_WORKAREA") ||
+                g_str_has_prefix (gdk_x11_get_xatom_name (xevent->xproperty.atom), "_GTK_WORKAREAS_D")) {
                 update_margins (icon_view);
             }
             break;
@@ -310,13 +313,15 @@ realized_callback (GtkWidget *widget, NemoDesktopIconGridView *desktop_icon_grid
 
   desktop_icon_grid_view->details->root_window = root_window;
 
-  update_margins (desktop_icon_grid_view);
-
   /* Setup the property filter */
   gdk_window_set_events (root_window, GDK_PROPERTY_CHANGE_MASK);
   gdk_window_add_filter (root_window,
                          gdk_filter_func,
                          desktop_icon_grid_view);
+
+  /* Read the margins after selecting the property events, so that
+   * a workarea change in between is not missed */
+  update_margins (desktop_icon_grid_view);
 }
 
 static void
diff --git a/src/nemo-desktop-icon-view.c b/src/nemo-desktop-icon-view.c
index e781bc0..2b4ab24 100644
--- a/src/nemo-desktop-icon-view.c
+++ b/src/nemo-desktop-icon-view.c
@@ -132,7 +132,10 @@ gdk_filter_func (GdkXEvent *gdk_xevent,
 
     switch (xevent->type) {
         case PropertyNotify:
-            if (xevent->xproperty.atom == gdk_x11_get_xatom_by_name ("_NET_WORKAREA")) {
+            /* GTK prefers _GTK_WORKAREAS_D* over _NET_WORKAREA, which the WM
+             * may update after _NET_WORKAREA, so watch for both */
+            if (xevent->xproperty.atom == gdk_x11_get_xatom_by_name ("_NET_WORKAREA") ||
+                g_str_has_prefix (gdk_x11_get_xatom_name (xevent->xproperty.atom), "_GTK_WORKAREAS_D")) {
                 update_margins (icon_view);
             }
             break;
@@ -231,13 +234,15 @@ realized_callback (GtkWidget *widget, NemoDesktopIconView *desktop_icon_view)
 
   desktop_icon_view->details->root_window = root_window;
 
-  update_margins (desktop_icon_view);
-
   /* Setup the property filter */
   gdk_window_set_events (root_window, GDK_PROPERTY_CHANGE_MASK);
   gdk_window_add_filter (root_window,
                          gdk_filter_func,
                          desktop_icon_view);
+
+  /* Read the margins after selecting the property events, so that
+   * a workarea change in between is not missed */
+  update_margins (desktop_icon_view);
 }
 
 static void
