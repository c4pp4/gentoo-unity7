ehooks() {
	## Status Icon Plugin first run defaults ##
	sed -i \
		-e "/constexpr StatusIcon/{s/false/true/}" \
		-e "/close_to_tray/{s/FALSE/TRUE/}" \
		src/statusicon/statusicon.cc || die
	grep -Fq "constexpr StatusIcon () : GeneralPlugin (info, true)" src/statusicon/statusicon.cc || die
	grep -Fq '"close_to_tray", "TRUE"' src/statusicon/statusicon.cc || die

	## Desktop Notifications Plugin first run defaults ##
	sed -i \
		-e "/constexpr NotifyPlugin/{s/false/true/}" \
		-e "/actions/{s/TRUE/FALSE/}" \
		src/notify/notify.cc || die
	grep -Fq "constexpr NotifyPlugin () : GeneralPlugin (info, true)" src/notify/notify.cc || die
	grep -Fq '"actions", "FALSE"' src/notify/notify.cc || die
}
