 CMakeLists.txt        |   2 +
 gtk/Application.cc    |   1 +
 gtk/SystemTrayIcon.cc | 254 ++++++++++++++++++++++++++++++++++++++++--
 3 files changed, 247 insertions(+), 10 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 51056f6..4879ddb 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -355,6 +355,8 @@ if(ENABLE_GTK)
         tr_get_required_flag(WITH_APPINDICATOR APPINDICATOR_IS_REQUIRED)
         find_package(APPINDICATOR ${APPINDICATOR_IS_REQUIRED})
         tr_fixup_auto_option(WITH_APPINDICATOR APPINDICATOR_FOUND APPINDICATOR_IS_REQUIRED)
+    elseif(ENABLE_GTK AND WITH_APPINDICATOR)
+        pkg_check_modules(APPINDICATOR REQUIRED dbusmenu-glib-0.4)
     else()
         set(WITH_APPINDICATOR OFF)
     endif()
diff --git a/gtk/Application.cc b/gtk/Application.cc
index f375209..523070b 100644
--- a/gtk/Application.cc
+++ b/gtk/Application.cc
@@ -777,6 +777,7 @@ void Application::Impl::app_setup()
     {
         gtr_window_set_skip_taskbar_hint(*wind_, icon_ != nullptr);
         gtr_action_set_toggled("toggle-main-window", false);
+        is_iconified_ = true;
     }
