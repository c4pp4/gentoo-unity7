fetch_debian() {
	local \
		archive=$2.debian.tar.${3:-xz} \
		blake=$1 \
		cache="${PORTAGE_ACTUAL_DISTDIR:-${DISTDIR}}/ehooks" \
		wlog="${T}/wget.log" \
		ret=1 \
		src=${2%%_*} \
		mirror name pool url
	local -a mirrors tries urls

	# Keep the archive in a subdirectory of the real DISTDIR, like git-r3.eclass #
	# does, so that a reinstallation does not need Launchpad. eclean-dist #
	# removes only regular files, so it keeps the subdirectory #
	addwrite "${cache}"
	mkdir -p "${cache}" || die

	if [[ -s ${cache}/${archive} ]]; then
		einfo "Using ${color_bold}${archive}${color_norm} from ${cache}"
		ebegin "Checking BLAKE2 checksum"
			b2sum --status -c <(echo "${blake}  ${cache}/${archive}")
			ret=$?
		eend ${ret}
	fi
	if [[ ${ret} -ne 0 ]]; then
		# As in ubuntu-versionator.eclass, the sources of profiles/thirdpartymirrors: #
		# Launchpad, which keeps every file, the independent Ubuntu archive mirrors #
		# in random order, the Ubuntu archive and the old releases archive #
		pool=${src:0:1}
		[[ ${src} == lib* ]] && pool=${src:0:4}
		for name in launchpad mirrors archive old-releases; do
			read -ra mirrors < <(sed -n "s/^gentoo-unity7-${name}[[:space:]]\+//p" "${REPO_ROOT}"/profiles/thirdpartymirrors)
			for mirror in $(printf "%s\n" "${mirrors[@]}" | shuf); do
				if [[ ${name} == launchpad ]]; then
					urls+=( "${mirror}/${archive}" )
				else
					urls+=( "${mirror}/pool/"{main,universe}"/${pool}/${src}/${archive}" )
				fi
			done
		done

		> "${wlog}"
		ebegin "Downloading ${color_bold}${archive}${color_norm}"
			for url in "${urls[@]}"; do
				# A mirror without the file answers at once, Launchpad gets more time #
				[[ ${url} == "${urls[0]}" ]] && tries=( -t 3 -T 60 ) || tries=( -t 1 -T 30 )
				wget "${tries[@]}" -U "Portage (Gentoo, https://www.gentoo.org) distfile-fetch" -O "${T}/${archive}" -a "${wlog}" "${url}" && ret=0 && break
				rm -f "${T}/${archive}"
			done
		eend ${ret}
		[[ -s ${T}/${archive} ]] || { cat "${wlog}" >&2; die "ehooks: archive not fetched"; }
		ebegin "Checking BLAKE2 checksum"
			b2sum --status -c <(echo "${blake}  ${T}/${archive}") || die "ehooks: archive checksum did not match"
		eend $?
		mv "${T}/${archive}" "${cache}/" || die
	fi

	pushd "${S}" >/dev/null || die
		unpack "${cache}/${archive}"
	popd >/dev/null || die
}
