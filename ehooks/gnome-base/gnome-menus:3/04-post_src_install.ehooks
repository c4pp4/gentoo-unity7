ehooks() {
	# Build .directory files with inline translations as in debian/rules
	local file
	for file in "${S}"/debian/desktop-files/*.directory.desktop.in; do
		msgfmt --desktop --template "${file}" -d "${S}"/debian/po-up -o "${file%.desktop.in}" || die
	done

	insinto /usr/share/desktop-directories
	doins "${S}"/debian/desktop-files/*.directory
}
