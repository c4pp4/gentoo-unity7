From 15c2085e7fcaf1ff51b935a3344f308561c8c695 Mon Sep 17 00:00:00 2001
From: c4pp4
Date: Thu, 22 Oct 2026 00:49:01 +0200
Subject: [PATCH 1/1] Populate Firefox/Thunderbird global submenus

GtkMenu fixates the size of its toplevel after it has been positioned
by move-to-rect (needed on Wayland, where a positioned popup must not be
resized). Unity's global menu is rendered by unity-panel-service and the
items of Firefox and Thunderbird submenus arrive via dbusmenu only after
the submenu is shown, so the fixated menu stays at the size of the empty
menu. Don't fixate the size when running in Unity (X11 only).

gtk_window_fixate_size () is used only here, the change affects GtkMenu
popups whose content changes while they are open, and only in Unity.

Signed-off-by: c4pp4
---
 gtk/gtkmenu.c | 26 +++++++++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/gtk/gtkmenu.c b/gtk/gtkmenu.c
index 5001949..f87763b 100644
--- a/gtk/gtkmenu.c
+++ b/gtk/gtkmenu.c
@@ -1392,6 +1392,26 @@ gtk_menu_init (GtkMenu *menu)
   gtk_css_node_set_state (bottom_arrow_node, gtk_css_node_get_state (widget_node));
 }
 
+static gboolean
+in_desktop (const gchar *name)
+{
+  const gchar *desktop_name_list;
+  gchar **names;
+  gboolean in_list = FALSE;
+  gint i;
+
+  desktop_name_list = g_getenv ("XDG_CURRENT_DESKTOP");
+  if (!desktop_name_list)
+    return FALSE;
+
+  names = g_strsplit (desktop_name_list, ":", -1);
+  for (i = 0; names[i] && !in_list; i++)
+    in_list = g_strcmp0 (names[i], name) == 0;
+  g_strfreev (names);
+
+  return in_list;
+}
+
 static void
 moved_to_rect_cb (GdkWindow          *window,
                   const GdkRectangle *flipped_rect,
@@ -1402,7 +1422,11 @@ moved_to_rect_cb (GdkWindow          *window,
 {
   GtkMenuPrivate *priv = menu->priv;
 
-  gtk_window_fixate_size (GTK_WINDOW (priv->toplevel));
+  /* Unity's global menu (unity-panel-service) gets the items of Firefox and
+   * Thunderbird submenus only after they are shown, so the menu has to be
+   * able to resize (X11 only, no compositor constraints as on Wayland) */
+  if (!in_desktop ("Unity"))
+    gtk_window_fixate_size (GTK_WINDOW (priv->toplevel));
 
   if (!priv->emulated_move_to_rect)
     g_signal_emit (menu,
