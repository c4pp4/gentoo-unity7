ehooks() {
	unpack "${EHOOKS_FILESDIR}"/global-menu-translations-xenial.tar.xz

	einfo "  Merging available translations..."

	local po_ext po_orig
	local -a po_files=( po/* )

	for po_ext in "${po_files[@]}"; do
		po_orig=${S}/${po_ext}

		if [[ -f ${po_orig} ]]; then
			msgcat --use-first -o "${po_orig}" "${po_orig}" "${po_ext}" 2>&1 || die	# ignore warning messages
		fi
	done
}
