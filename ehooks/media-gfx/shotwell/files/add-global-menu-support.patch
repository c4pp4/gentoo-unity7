From 0423598260f79c4585c482192a8119bdee033e18 Mon Sep 17 00:00:00 2001
From: c4pp4
Date: Mon, 23 Nov 2026 23:41:53 +0100
Subject: [PATCH 1/1] Add global menu support

Since the port to GTK 4, Shotwell draws its menu bar in the window and
no longer exports it.

Export the menu bar over D-Bus and hide the local one if the desktop
shell shows it (gtk-shell-shows-menubar). The menu bar is different for
each page. Export one menu and refill it when the page changes, because
the panel does not notice a new menu exported at the same object path.
Copy the items. If the menu bar is added as a section, unity-panel-service
leaks memory with every page change.

Signed-off-by: c4pp4
---
 src/AppWindow.vala | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/src/AppWindow.vala b/src/AppWindow.vala
index bf11457..75d8d07 100644
--- a/src/AppWindow.vala
+++ b/src/AppWindow.vala
@@ -20,6 +20,7 @@ public abstract class AppWindow : PageWindow {
     private static CommandManager command_manager = null;
 
     private Gtk.Box content_box = new Gtk.Box(Gtk.Orientation.VERTICAL, 0);
+    private GLib.Menu global_menu = new GLib.Menu();
     private Gtk.PopoverMenuBar menu_bar;
     private Gtk.Revealer menu_revealer = new Gtk.Revealer();
     
@@ -81,7 +82,6 @@ public abstract class AppWindow : PageWindow {
             menu_shortcuts = null;
         }
 
-        // TODO: Obey Gtk.Settings:gtk-shell-shows-menubar
         if (menu_model == null) {
             menu_revealer.set_reveal_child(false);
             menu_revealer.set_child(null);
@@ -90,18 +90,29 @@ public abstract class AppWindow : PageWindow {
             return;
         }
 
+        // The panel does not notice a new menu exported at the same object
+        // path, so refill the exported one
+        global_menu.remove_all();
+        for (var i = 0; i < menu_model.get_n_items(); i++) {
+            global_menu.append_item(new GLib.MenuItem.from_model(menu_model, i));
+        }
+
         // Collect shortcuts from menu
         menu_shortcuts = new Gtk.ShortcutController();
         get_accels_from_menu(menu_model, menu_shortcuts);
-        menu_bar = new Gtk.PopoverMenuBar.from_model(menu_model);
-        menu_revealer.set_child(menu_bar);
-        menu_revealer.set_reveal_child(true);
+        if (!get_settings().gtk_shell_shows_menubar) {
+            menu_bar = new Gtk.PopoverMenuBar.from_model(menu_model);
+            menu_revealer.set_child(menu_bar);
+            menu_revealer.set_reveal_child(true);
+        }
         ((Gtk.Widget)this).add_controller(menu_shortcuts);
     }
 
     protected AppWindow() {
         base();
 
+        application.set_menubar(global_menu);
+
         menu_revealer.vexpand = false;
         menu_revealer.hexpand = true;
         content_box.append(menu_revealer);
