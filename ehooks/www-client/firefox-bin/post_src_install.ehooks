ehooks() {
	# Add desktop launcher with quicklist and translations #
	domenu "${EHOOKS_FILESDIR}/${PN}.desktop"

	# ESR window class #
	if [[ -n ${MOZ_ESR} ]]; then
		sed -i "s/^StartupWMClass=firefox$/StartupWMClass=firefox-esr/" "${ED}"/usr/share/applications/${PN}.desktop || die
		grep -q "^StartupWMClass=firefox-esr$" "${ED}"/usr/share/applications/${PN}.desktop || die
	fi
}
